{
  "name": "taskos-worldlab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "pnpm --parallel --filter @taskos/api --filter @taskos/web --filter @taskos/demo-store dev",
    "dev:web": "pnpm --filter @taskos/web dev",
    "dev:api": "pnpm --filter @taskos/api dev",
    "dev:demo": "pnpm --filter @taskos/demo-store dev",
    "build": "pnpm -r --if-present build",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "db:generate": "pnpm --filter @taskos/database db:generate",
    "db:migrate": "pnpm --filter @taskos/database db:migrate",
    "db:studio": "pnpm --filter @taskos/database db:studio",
    "db:seed": "pnpm --filter @taskos/database db:seed",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/node": "^22.15.30",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.5",
    "globals": "^16.2.0",
    "prettier": "^3.5.3",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.0",
    "vitest": "^3.2.3"
  }
}
