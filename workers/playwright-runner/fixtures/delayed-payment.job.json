{
  "workerId": "local-worker-delayed", "experimentId": "delayed-payment-experiment", "worldId": "delayed-payment-world",
  "target": { "baseUrl": "http://127.0.0.1:5174", "journeyPath": "/products/sku-1" },
  "browser": { "engine": "chromium", "viewport": "desktop", "headless": true },
  "journey": {
    "id": "commerce-checkout", "name": "Delayed payment checkout",
    "steps": [
      { "type": "goto", "path": "/products/sku-1", "name": "product" },
      { "type": "click", "selector": "[data-testid=\"add-to-cart\"]", "name": "add-to-cart" },
      { "type": "click", "selector": "[data-testid=\"checkout\"]", "name": "checkout" },
      { "type": "fill", "selector": "[data-testid=\"email\"]", "value": "worker@example.test" },
      { "type": "click", "selector": "[data-testid=\"place-order\"]", "name": "payment-submit", "screenshotCheckpoint": true },
      { "type": "waitFor", "selector": "[data-testid=\"order-confirmation\"]", "timeoutMs": 15000 }
    ],
    "successCondition": { "type": "visible", "selector": "[data-testid=\"order-confirmation\"]" }
  },
  "world": { "userProfile": "normal", "networkProfile": "high-latency", "latencyMs": 150, "paymentDelayMs": 1200, "doubleSubmit": false, "clearStorageBeforeRun": true, "submitSelector": "[data-testid=\"place-order\"]", "paymentUrlPatterns": ["/api/payment", "/api/payments", "/api/checkout"], "randomSeed": 202, "reason": "Verify a patient customer under a delayed payment response." },
  "invariants": [{ "id": "no-duplicate-payment", "type": "NO_DUPLICATE_PAYMENT", "severity": "CRITICAL" }],
  "evidence": { "outputDirectory": "./artifacts/delayed-payment", "screenshots": true, "trace": true, "console": true, "network": true, "video": false },
  "limits": { "timeoutMs": 45000 }
}
