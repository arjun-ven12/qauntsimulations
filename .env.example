DAYTONA_MAX_SANDBOXES_PER_INVESTIGATION=2
DAYTONA_MAX_RETRY_ATTEMPTS=2
DAYTONA_RETRY_BASE_DELAY_MS=1000
DAYTONA_RETRY_MAX_DELAY_MS=10000
DAYTONA_SANDBOX_TIMEOUT_SECONDS=300
DAYTONA_CLEANUP_TIMEOUT_SECONDS=60
DAYTONA_FLEET_HARD_LIMIT=4
DAYTONA_ORPHAN_SWEEP_ENABLED=true
DAYTONA_ORPHAN_MAX_AGE_MINUTES=30
DAYTONA_MAX_TOTAL_SANDBOX_CREATIONS_PER_INVESTIGATION=8
