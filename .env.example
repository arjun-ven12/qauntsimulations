NODE_ENV=development
PORT=4000
WEB_URL=http://localhost:5173
API_URL=http://localhost:4000
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/taskos?sslmode=require
DIRECT_URL=postgresql://user:password@host.region.aws.neon.tech/taskos?sslmode=require
JWT_ACCESS_SECRET=replace-with-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-another-32-character-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_DOMAIN=
COOKIE_SECURE=false
BCRYPT_ROUNDS=12
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_PLANNER=gpt-5-mini
OPENAI_MODEL_EXPLANATION=gpt-5-mini
OPENAI_MODEL_VISION=gpt-5-mini
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=
NOSANA_ENABLED=false
NOSANA_API_KEY=
NOSANA_BASE_URL=
NOSANA_MODEL=
DAYTONA_API_KEY=
DAYTONA_API_URL=
DAYTONA_TARGET=
DAYTONA_SNAPSHOT=
DAYTONA_MAX_CONCURRENT_SANDBOXES=4
DAYTONA_SANDBOX_TIMEOUT_SECONDS=900
EVIDENCE_STORAGE_PROVIDER=local
EVIDENCE_LOCAL_PATH=./storage/evidence
VITE_API_URL=http://localhost:4000/api
VITE_USE_MOCK_API=true
DEMO_DUPLICATE_PAYMENT_BUG=true
DEMO_INVENTORY_RACE_BUG=false
